NODE_ENV=production

# Web/API ports
FRONTEND_PORT=8080
BACKEND_PORT=8081

# MongoDB
MONGO_INITDB_ROOT_USERNAME=freeacs_root
MONGO_INITDB_ROOT_PASSWORD=replace-with-a-long-random-password
APP_DB_NAME=freeacs_control

# ACS
GENIEACS_VERSION=1.2.16
GENIEACS_UI_JWT_SECRET=replace-with-a-long-random-secret
ACS_CWMP_PUBLIC_URL=http://localhost:7547

# Backend security
JWT_SECRET=replace-with-at-least-32-random-characters
COOKIE_SECURE=false
CORS_ORIGIN=http://localhost:8080
SESSION_TTL_SECONDS=28800
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
LOGIN_RATE_LIMIT_MAX=5
BCRYPT_ROUNDS=12

# First boot admin
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_PASSWORD=ChangeMeNow-Use-A-Long-Password

